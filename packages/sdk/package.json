{
  "name": "@ovxa/sdk",
  "version": "0.1.0",
  "description": "The OVXA SDK — one import to generate, stream, and render interfaces.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ovxa/client": "0.1.0",
    "@ovxa/react": "0.1.0",
    "@ovxa/registry": "0.1.0",
    "@ovxa/schema": "0.1.0",
    "@ovxa/surface-kit": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
