{
  "name": "@ovxa/site",
  "version": "0.1.0",
  "description": "The ovxa.ai landing page as static files, with a Node handler that serves them.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./public/*": "./public/*"
  },
  "files": [
    "dist",
    "public"
  ],
  "scripts": {
    "build": "tsc -b",
    "prepare": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  }
}
