{
  "name": "ovxa",
  "version": "0.1.0",
  "private": true,
  "description": "The UI Intelligence Engine for Generative UI",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "check:dist": "node scripts/check-dist.mjs",
    "clean": "tsc -b tsconfig.build.json --clean",
    "dev": "tsc -b tsconfig.build.json --watch",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "4.5.4"
  }
}
